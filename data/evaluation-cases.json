    "expected_control": "DP-07",
    "expected_document": "Data Processing Addendum.pdf",
    "expected_outcome": "partial",
    "must_include": ["90 days"],
    "must_not_include": ["30 days"]
  },
  {
    "id": "eval-encryption",
    "question": "Which encryption standards are documented?",
    "expected_control": "CR-04",
    "expected_document": "Security Overview.pdf",
    "expected_outcome": "met",
    "must_include": ["AES-256", "TLS 1.2"],
    "must_not_include": ["TLS 1.3 required"]
